NODE_ENV=development
PORT=8080

DB_HOST=localhost
DB_PORT=5434
DB_NAME=etp_db
DB_USER=etp_user
DB_PASSWORD=etp_password

DATABASE_URL=postgresql://etp_user:etp_password@localhost:5434/etp_db

# Use esta URL caso o backend seja Spring Boot:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/etp_db
# SPRING_DATASOURCE_USERNAME=etp_user
# SPRING_DATASOURCE_PASSWORD=etp_password

# Troque este valor antes de usar autenticacao real.
JWT_SECRET=troque-esta-chave-em-desenvolvimento
